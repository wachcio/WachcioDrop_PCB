# ------------------------------------------------------------
# KiCad: pliki tymczasowe, awaryjne kopie i autosave
# ------------------------------------------------------------
*.000
*.bak
*.bck
*.tmp
*.kicad_pcb-bak
*.kicad_sch-bak
*.sch-bak
*-bak
*-bak*
*~
~*
_autosave-*
\#auto_saved_files\#
~*.lck

# Automatyczne archiwa backupów KiCad
/*-backups/
**/*-backups/*.zip

# Lokalny stan projektu / cache — zależny od użytkownika i komputera
*.kicad_prl
fp-info-cache

# ------------------------------------------------------------
# Eksporty i pliki pośrednie — odtwarzalne ze źródeł projektu
# ------------------------------------------------------------
*.net
*.dsn
*.ses

# Jeśli eksporty są generowane automatycznie, trzymaj je poza repo
/gerbers/
/fabrication/
/assembly/
/production/
/output/
/build/

# Raporty wygenerowane przez DRC / ERC
*-drc.rpt
*-erc.rpt
*.drc
*.rpt

# BOM/POS: ignoruj tylko, jeśli generujesz je automatycznie
# Odkomentuj, jeżeli nie chcesz ich commitować:
# *.csv
# *.xml

# ------------------------------------------------------------
# System / edytory
# ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
